#!/bin/bash
#
# PID 1 for exe.dev VMs: prepare the environment, then hand off to systemd.
#
# Mirrors the precursor steps exeuntu's own /usr/local/bin/init performs.
# Without these, systemd either refuses to start or comes up with no cgroup
# controllers and no ability to bind low ports.

if [[ $$ != 1 ]]; then
	# systemd emits a very opaque telinit error otherwise.
	echo "Must be run as pid 1 for systemd to start."
	exit 1
fi

mkdir -p /run/systemd
if [[ ! -f /sys/fs/cgroup/cgroup.controllers ]]; then
	mount -t cgroup2 none /sys/fs/cgroup
fi

# Kata containers mount this readonly by default. exeuntu does this remount
# *after* the sysctl writes below, which works only because /proc/sys happens
# to be writable on the current runtime (verified: ip_unprivileged_port_start
# is 0 on live VMs, and services running as exedev do bind :80). Do it first
# regardless: if /proc/sys ever arrives read-only, the `-w` guards below
# would silently skip and low-port binding would break with no error.
mount -o remount,rw /proc/sys 2>/dev/null || true

# A missing or read-only sysctl is normal on some container runtimes. Keep
# booting in that case rather than turning a hardening preference into an
# unavailable VM.
set_sysctl_if_writable() {
	local key=$1 value=$2 path
	path="/proc/sys/${key//./\/}"
	[[ -w "$path" ]] && printf '%s\n' "$value" >"$path"
}

# Let unprivileged services bind :80/:443 directly.
set_sysctl_if_writable net.ipv4.ip_unprivileged_port_start 0
# Absent entirely on VMs without IPv6 sysctls; the helper handles that.
set_sysctl_if_writable net.ipv6.ip_unprivileged_port_start 0

# Do not accept IPv4 ICMP redirects globally.
set_sysctl_if_writable net.ipv4.conf.all.accept_redirects 0
# New interfaces default to not accepting IPv4 ICMP redirects.
set_sysctl_if_writable net.ipv4.conf.default.accept_redirects 0
# Do not accept IPv6 Redirect messages globally.
set_sysctl_if_writable net.ipv6.conf.all.accept_redirects 0
# New interfaces default to not accepting IPv6 Redirect messages.
set_sysctl_if_writable net.ipv6.conf.default.accept_redirects 0
# Disable acceptance of IPv4 source-routed packets globally.
set_sysctl_if_writable net.ipv4.conf.all.accept_source_route 0
# New interfaces default to rejecting IPv4 source routing.
set_sysctl_if_writable net.ipv4.conf.default.accept_source_route 0
# Do not send IPv4 ICMP redirects.
set_sysctl_if_writable net.ipv4.conf.all.send_redirects 0

echo "Starting systemd..."
exec /sbin/init --log-target=syslog --show-status=true
