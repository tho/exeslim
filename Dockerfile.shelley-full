# Shelley with every feature working: Dockerfile.shelley plus the external
# programs Shelley runs. Each package below is there for a Shelley feature,
# found by reading its source (github.com/boldsoftware/shelley):
#
#   headless-shell, libnss3,   browser tool, screenshots. Shelley looks for it at
#   fontconfig, fonts          /headless-shell/headless-shell, and its upgrade
#                              button replaces that directory. Fonts so pages
#                              and emoji render in screenshots. libnss3-tools
#                              for certutil, see the eMudhra note below.
#   ffmpeg (ffprobe)           voice and video: /transcription probes uploaded
#                              recordings, extracts AAC audio and makes a video
#                              contact sheet; browser screencasts to H.264.
#   imagemagick, libheif       HEIC/AVIF image uploads (`convert heic:- png:-`).
#   git                        diff view, commit tours, worktrees, git state.
#
# jq, sqlite3 and lsof come from Dockerfile.shelley.
#
# Not here: Node (Shelley's MCP client speaks HTTP only, never `npx`), language
# toolchains, and anything only exeuntu's other agents use. Ubuntu's ffmpeg
# drags in Mesa and LLVM (~200 MB, via libavdevice); that is the cost of the
# packaged, security-updated build, the one exeuntu also uses.
ARG BASE=ghcr.io/tho/exeslim:latest-shelley

# The headless-shell (Chromium) build Shelley's release metadata advertises for
# this platform, so it matches what Shelley upgrades to, as exeuntu does. The
# stage runs on the base rather than a stock image because it needs only curl
# and jq, which the base has.
FROM ${BASE} AS chrome
ARG TARGETARCH
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
RUN curl -fsSL --retry 5 --retry-all-errors -o /tmp/release.json https://boldsoftware.github.io/shelley/release.json && \
	build=$(jq -ce --arg p "linux_$TARGETARCH" '.headless_shells[$p] // error("no headless_shells.\($p) in release.json")' /tmp/release.json) && \
	version=$(jq -r .version <<<"$build") && \
	url=$(jq -r .url <<<"$build") && \
	[[ $url == https://github.com/boldsoftware/shelley/releases/download/headless-shell/v"${version#Chromium }"/* ]] && \
	curl -fsSL --retry 5 --retry-all-errors -o /tmp/headless-shell.tar.gz "$url" && \
	tar -xzf /tmp/headless-shell.tar.gz -C / --no-same-owner && \
	[[ -x /headless-shell/headless-shell ]] && \
	# Record the release, which the binary's --version can't show, for Shelley's version check.
	sum=$(sha256sum /headless-shell/headless-shell | cut -d' ' -f1) && \
	printf '%s\nsha256 %s\n' "$version" "$sum" > /headless-shell/headless-shell-version.txt

FROM ${BASE}
ARG BASE

RUN apt-get update \
	&& DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
		libnss3 libnss3-tools fontconfig fonts-dejavu-core fonts-noto-color-emoji \
		ffmpeg \
		imagemagick libheif1 libheif-plugin-libde265 \
		git \
	&& apt-get clean \
	&& rm -rf /var/lib/apt/lists/* \
	&& git config --system init.defaultBranch main

COPY --from=chrome /headless-shell /headless-shell
# shelley.service sets its own PATH with /headless-shell first; this is for
# SSH sessions.
ENV PATH="/headless-shell:${PATH}"

# Chromium blocks the compromised eMudhra intermediates only since
# 156.0.8078.69 and 157.0.8103.20; distrust the root above them in exedev's
# NSS database, which older builds honor too. As exedev: the database is
# ~/.pki/nssdb, which headless-shell reads and Shelley runs as exedev.
USER exedev
# hadolint cannot see that this stage inherits the base's SHELL, which sets
# pipefail.
# hadolint ignore=DL4006
RUN --mount=type=bind,source=distrust-emudhra.sh,target=/tmp/distrust-emudhra.sh \
	bash /tmp/distrust-emudhra.sh && \
	certutil -L -d sql:/home/exedev/.pki/nssdb | grep -q '^distrusted emSign ECC Root CA - G3  *p,p,p$'
USER root

LABEL org.opencontainers.image.title="exeslim-shelley-full" \
	org.opencontainers.image.base.name="${BASE}" \
	org.opencontainers.image.description="Minimal exe.dev base image with Shelley and the tools all its features need: browser, voice, video and git."
