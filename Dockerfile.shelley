# Shelley with its small tools: exe.dev installs the Shelley binary at
# /usr/local/bin/shelley when creating a VM from this image, but does not start
# it, so the image ships the units. These are exeuntu's (socket activation on
# 127.0.0.1:9999 and on the Shelley CLI's socket in ~/.config/shelley, which
# the tmpfiles entry keeps exedev's at boot). jq and sqlite3 are for built-in
# skills (mcp, transcribing-audio, previous-conversations); lsof names the
# process holding a port Shelley wants. Browser, voice, video and git features
# need Dockerfile.shelley-full, which builds on this. nftables loads the rule
# that keeps svc-<app> units off Shelley's port, image/shelley-guard.nft.
ARG BASE=ghcr.io/tho/exeslim:latest
FROM ${BASE}
ARG BASE

COPY --chmod=0644 shelley.socket shelley.service /etc/systemd/system/
COPY --chmod=0644 tmpfiles-shelley.conf /etc/tmpfiles.d/shelley.conf
COPY --chmod=0644 image/shelley-guard.nft /etc/shelley-guard.nft
COPY --chmod=0644 image/shelley-guard.service /etc/systemd/system/shelley-guard.service
COPY --chmod=0644 image/shelley-guard-socket.conf /etc/systemd/system/shelley.socket.d/10-guard.conf
RUN systemctl enable shelley.socket \
	&& apt-get update \
	&& DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
		jq sqlite3 lsof nftables \
	&& apt-get clean \
	&& rm -rf /var/lib/apt/lists/* \
	# Package configuration can bake in a machine ID, which every VM would then
	# share; the base emptied it before these packages were installed.
	&& : > /etc/machine-id

EXPOSE 9999

LABEL "exe.dev/install-shelley"="true" \
	org.opencontainers.image.title="exeslim-shelley" \
	org.opencontainers.image.base.name="${BASE}" \
	org.opencontainers.image.description="Minimal exe.dev base image with Shelley installation enabled, without the tools Shelley's browser, voice, video and git features need."
